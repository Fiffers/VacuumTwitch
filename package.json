{
    "name": "vacuumtwich",
    "version": "1.0.1",
    "description": "Twitch TV interface on the desktop",
    "main": "index.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder -wml",
        "build-appimage": "electron-builder --linux appimage",
        "flatpak:build-unpacked": "electron-builder --linux --dir"
    },
    "keywords": [],
    "author": "superkeka (superkeka@0xe.app)",
    "license": "MIT",
    "build": {
        "appId": "app.0xe.VacuumTwitch",
        "productName": "VacuumTwitch",
        "artifactName": "VacuumTwitch-${arch}.${ext}",
        "linux": {
            "icon": "./assets/icons",
            "synopsis": "Twitch TV interface on the desktop",
            "category": "AudioVideo",
            "desktop": {
                "Name": "VacuumTwitch",
                "GenericName": "Twitch Leanback",
                "Type": "Application",
                "Categories": "AudioVideo;",
                "Keywords": "Twitch;TV;"
            },
            "maintainer": "superkeka+vacuumtwitch@0xe.app",
            "target": [
                {
                    "target": "deb",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "mac": {
            "icon": "./assets/icon.icns",
            "category": "public.app-category.entertainment",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "win": {
            "icon": "./assets/icon.ico",
            "artifactName": "VacuumTwitch-${arch}-Portable.zip",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "nsis": {
            "artifactName": "VacuumTwitch-Setup.${ext}",
            "uninstallDisplayName": "VacuumTwitch",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "perMachine": false
        },
        "publish": {
            "provider": "github",
            "owner": "Fiffers",
            "repo": "VacuumTwitch"
        }
    },
    "devDependencies": {
        "electron": "^35.5.1",
        "electron-builder": "^25.1.8"
    },
    "dependencies": {
        "electron-updater": "^6.6.2"
    }
}
